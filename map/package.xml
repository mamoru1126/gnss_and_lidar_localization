<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gll_map</name>
  <version>0.1.0</version>
  <description>ROS-independent library for tiling point cloud maps and loading the tiles around a moving pose.</description>
  <maintainer email="sunottty1126@gmail.com">sunomamo1126</maintainer>
  <license>MIT</license>

  <buildtool_depend>cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>geographiclib</depend>
  <depend>yaml-cpp</depend>
  <!-- small_gicp（v1.0.1）は任意。あればタイル化のときに点ごとの共分散を計算する（docker/Dockerfile） -->
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>

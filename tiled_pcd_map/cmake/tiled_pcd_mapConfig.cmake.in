@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 NO_MODULE)
find_dependency(Threads)
# tiled_pcd_map は静的ライブラリなので、非公開の依存もリンク時に必要になる
find_dependency(yaml-cpp)
set(TILED_PCD_MAP_WITH_SMALL_GICP @TILED_PCD_MAP_WITH_SMALL_GICP@)
if(TILED_PCD_MAP_WITH_SMALL_GICP)
  find_dependency(OpenMP COMPONENTS CXX)
  find_dependency(small_gicp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tiled_pcd_mapTargets.cmake")
check_required_components(tiled_pcd_map)

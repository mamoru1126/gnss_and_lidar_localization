@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 NO_MODULE)
find_dependency(gll_map)
# gll_core は静的ライブラリなので、非公開の依存もリンク時に必要になる
find_dependency(OpenMP COMPONENTS CXX)
find_dependency(small_gicp)

include("${CMAKE_CURRENT_LIST_DIR}/gll_coreTargets.cmake")
check_required_components(gll_core)
